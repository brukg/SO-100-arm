<?xml version='1.0' encoding='UTF-8'?>
<package format="2">
  <name>so_arm_100_5dof_arm_ikfast_plugin</name>
  <version>0.1.0</version>
  <description>IKFast plugin for so_arm_100_5dof</description>
  <maintainer email="bruk@signalbotics.com">Bruk Gebregziabher</maintainer>
  <maintainer email="rhys.mainwaring@me.com">Rhys Mainwaring</maintainer>
  <license>Apache 2.0</license>
  <url type="repository">https://github.com/brukg/SO-100-arm</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>tf2_eigen</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>liblapack-dev</build_depend>
  <build_depend>tf2_kdl</build_depend>
  <build_depend>moveit_core</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>moveit_core</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>liblapack-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <moveit_core plugin="${prefix}/so_arm_100_5dof_arm_moveit_ikfast_plugin_description.xml"/>
  </export>
</package>
